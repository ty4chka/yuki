// verify.ykn — слой доверия yuki.
//   1. BLAKE3 архива (формат "blake3:<hex>", как в [libs.runtime] у yukino)
//   2. Ed25519-подпись с доменным разделителем
//   3. Аудит tar-архива ДО распаковки: пути, ссылки, setuid, лимиты размера

load std.strings: split, starts_with, contains, eq, lower, slice, trim
load std.hash: hex_to_bytes, constant_time_eq_str
load std.hash.blake3: blake3_file
load std.crypto: ed25519_verify
load std.fs.files: file_read_text
load std.fs.archives.tar: tar_list
load .util: is_hex

// Коды: 1 — несовпадение хеша, 2 — неверный формат хеша, 3 — плохая подпись,
//       4 — небезопасный путь, 5 — ссылка/спецфайл в архиве, 6 — превышен лимит
public struct VerifyError {
    message: string
    code: int32
    path: string
}

public struct AuditReport {
    entries: int64
    total_bytes: int64
}

static SIG_DOMAIN: string = "yuki-v1\n"

// Что именно подписывается: подпись нельзя переиспользовать как чужую.
public fun signed_message(text: string) -> string {
    return SIG_DOMAIN + text
}

// ── 1. хеш ──────────────────────────────────────────────────────────────

public fun checksum_ok_format(c: string) -> bool {
    if !starts_with(c, "blake3:") || c.len() != 71 {
        return false
    }
    return is_hex(slice(c, 7, 71))
}

public fun check_blake3(path: string, expected: string) {
    if !checksum_ok_format(expected) {
        panic(VerifyError {
            message: "checksum must look like blake3:<64 hex chars>",
            code: 2,
            path: path,
        })
    }
    set want = lower(slice(expected, 7, 71))
    set got = lower(blake3_file(path))
    if !constant_time_eq_str(want, got) {
        panic(VerifyError {
            message: "blake3 mismatch: expected " + want + ", got " + got,
            code: 1,
            path: path,
        })
    }
}

// ── 2. подпись ──────────────────────────────────────────────────────────

public fun verify_text(pubkey_hex: string, text: string, sig_hex: string) -> bool {
    if pubkey_hex.len() != 64 || sig_hex.len() != 128 {
        return false
    }
    if !is_hex(pubkey_hex) || !is_hex(sig_hex) {
        return false
    }
    set pk: bytes = hex_to_bytes(pubkey_hex)
    set sig: bytes = hex_to_bytes(sig_hex)
    set msg: bytes = cast(signed_message(text), "bytes")
    return ed25519_verify(ref pk, ref msg, ref sig)
}

public fun verify_signature(pubkey_hex: string, message_path: string, sig_hex: string) -> bool {
    return verify_text(pubkey_hex, file_read_text(message_path), sig_hex)
}

// Индекс ключа, которым подписан текст, или -1.
public fun verify_text_with_any(ref keys: string[], text: string, sig_hex: string) -> int64 {
    for i in 0..keys.len() {
        if verify_text(trim(keys[i]), text, trim(sig_hex)) {
            return i
        }
    }
    return -1
}

// ── 3. аудит архива ─────────────────────────────────────────────────────

public fun is_safe_rel_path(p: string) -> bool {
    if p.len() == 0 || p.len() > 1024 {
        return false
    }
    if starts_with(p, "/") || contains(p, "\\") || contains(p, "\0") || contains(p, ":") {
        return false
    }
    set parts = split(p, "/")
    for i in 0..parts.len() {
        if eq(parts[i], "..") {
            return false
        }
    }
    return true
}

// Безопасная цель симлинка: относительная, без пробелов и ":", после разбора ".." остаётся
// внутри usr/, opt/ или etc/ (то есть не выходит из дерева пакета наружу).
public fun link_target_ok(link_rel: string, target: string) -> bool {
    if target.len() == 0 || target.len() > 512 {
        return false
    }
    if starts_with(target, "/") || contains(target, "\\") || contains(target, ":") || contains(target, " ") || contains(target, "\0") || contains(target, "|") {
        return false
    }
    set base = split(link_rel, "/")
    set stack: string[] = []
    for i in 0..(base.len() - 1) {
        if base[i].len() > 0 {
            stack.push(base[i])
        }
    }
    set parts = split(target, "/")
    for i in 0..parts.len() {
        if eq(parts[i], "..") {
            if stack.len() == 0 {
                return false
            }
            stack.pop()
        } elif parts[i].len() > 0 && !eq(parts[i], ".") {
            stack.push(parts[i])
        }
    }
    if stack.len() < 2 {
        return false
    }
    return eq(stack[0], "usr") || eq(stack[0], "opt") || eq(stack[0], "etc")
}

public fun audit_tar(archive: string, max_entries: int64, max_total: int64, max_file: int64, allow_links: bool) -> AuditReport {
    set entries = tar_list(archive)
    if entries.len() > max_entries {
        panic(VerifyError {
            message: "too many entries in archive",
            code: 6,
            path: archive,
        })
    }

    set setid_bits: uint32 = 3072
    set zero: uint32 = 0
    set total: int64 = 0

    for i in 0..entries.len() {
        if !is_safe_rel_path(entries[i].path) {
            panic(VerifyError {
                message: "unsafe path inside archive: " + entries[i].path,
                code: 4,
                path: archive,
            })
        }
        if entries[i].link_target.len() > 0 {
            if !allow_links || !link_target_ok(entries[i].path, entries[i].link_target) {
                panic(VerifyError {
                    message: "unsafe or forbidden symlink: " + entries[i].path,
                    code: 5,
                    path: archive,
                })
            }
            continue
        }
        if !entries[i].is_file && !entries[i].is_dir {
            panic(VerifyError {
                message: "special files are not allowed: " + entries[i].path,
                code: 5,
                path: archive,
            })
        }
        set masked: uint32 = entries[i].mode & setid_bits
        if masked != zero {
            panic(VerifyError {
                message: "setuid/setgid bit is not allowed: " + entries[i].path,
                code: 5,
                path: archive,
            })
        }
        if entries[i].size > max_file {
            panic(VerifyError {
                message: "file is too large: " + entries[i].path,
                code: 6,
                path: archive,
            })
        }
        rewrite total += entries[i].size
        if total > max_total {
            panic(VerifyError {
                message: "archive expands beyond the size limit",
                code: 6,
                path: archive,
            })
        }
    }
    return AuditReport { entries: entries.len(), total_bytes: total }
}
