// rotation.ykn — ротация и отзыв ключей реестра.
//
// <index>/keys/rotation.json  { "seq": 7, "expires": 1798761600,
//                               "add": [{"name": "main2", "key": "<64 hex>"}],
//                               "revoke": ["<64 hex>"] }
// <index>/keys/rotation.sigs  строки "<pubkey hex> <signature hex>"
//
// Применяется, только если её подписали не меньше threshold РАЗНЫХ ключей, которым
// клиент уже доверяет. Новый ключ сам себя ввести не может. Отозванный ключ попадает
// в revoked_keys и больше не доверяется, даже если его вернут в trusted_keys.

load core.utils: cast
load core.panic: panic
load std.json: json_parse
load std.fs.files: file_read_text
load std.strings: lines, split, trim, eq, lower
load std.fs.paths: path_join
load .errors: YukiError, err
load .stage: stage_create, run_child, stage_remove
load .view: InstallView
load .trust: trusted_keys, threshold, revoke_key, trust_add, fingerprint
load .verify: verify_text
load .index: seen_get, seen_set
load .util: now_secs, is_hex, valid_name
load .priv: is_root
load .ui: ok, info, warn, step, c_accent, c_dim

fun rot_in_list(ref l: string[], x: string) -> bool {
    for i in 0..l.len() {
        if eq(l[i], x) {
            return true
        }
    }
    return false
}

public fun cmd_keys_refresh() {
    if !is_root() {
        panic(err("changing trusted keys needs root: run `sudo yuki keys refresh`", 750, ""))
    }
    step(1, 3, "fetching the key rotation file (unprivileged)")
    set stage = stage_create()
    sus {
        set quiet = init InstallView("", false)
        set nomap: int64[] = []
        run_child(stage, "keys", ref ~quiet, ref nomap)
        set text = file_read_text(path_join(path_join(stage, "dl"), "rotation.json"))
        set sigs = lines(file_read_text(path_join(path_join(stage, "dl"), "rotation.sigs")))

        step(2, 3, "checking signatures as root")
        set keys = trusted_keys()
        set counted: string[] = []
        for i in 0..sigs.len() {
            set p = split(trim(sigs[i]), " ")
            if p.len() == 2 && rot_in_list(ref keys, lower(p[0])) && !rot_in_list(ref counted, lower(p[0])) {
                if verify_text(lower(p[0]), text, p[1]) {
                    counted.push(lower(p[0]))
                }
            }
        }
        set need = threshold()
        if counted.len() < need {
            panic(err("rotation is signed by " + cast(counted.len(), "string") + " trusted key(s), " + cast(need, "string") + " required", 760, "rotation.json"))
        }

        set doc = json_parse(text)
        set seq = doc.get("seq").as_int()
        if doc.get("expires").as_int() < now_secs() {
            panic(err("rotation file has expired", 761, "rotation.json"))
        }
        if seq < seen_get("__rotation__") {
            panic(err("rotation file is older than one already applied", 762, "rotation.json"))
        }

        step(3, 3, "applying")
        set add = doc.get("add")
        for i in 0..add.len() {
            set nm = add.at(i).get("name").as_string_or("")
            set key = lower(add.at(i).get("key").as_string_or(""))
            if valid_name(nm) && key.len() == 64 && is_hex(key) {
                sus {
                    trust_add(nm, key, add.at(i).get("role").as_string_or("publisher"), true)
                    ok("trusted new key " + c_accent(nm) + " " + c_dim(fingerprint(key)))
                } catch {
                    info("key " + nm + " is already known or revoked, skipped")
                }
            }
        }
        set rev = doc.get("revoke")
        for i in 0..rev.len() {
            set key = lower(rev.at(i).as_string_or(""))
            if key.len() == 64 && is_hex(key) {
                revoke_key(key)
                warn("revoked key " + c_dim(fingerprint(key)))
            }
        }
        seen_set("__rotation__", seq)
    } catch e: YukiError {
        stage_remove(stage)
        panic(e)
    } catch {
        stage_remove(stage)
        panic(err("key refresh failed: " + errkind, 763, ""))
    }
    stage_remove(stage)
    ok("keys are up to date")
}
