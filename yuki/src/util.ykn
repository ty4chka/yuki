// util.ykn — время, валидация имён/версий/hex.

load std.datetime: now_utc, to_unix_secs, to_unix_millis
load std.strings: split, lines, lower, pad_end, repeat, str_join, parse_int, slice, contains, eq
// В актуальном std эти функции возвращают T? (bool?/int64?), а проект работает
// с обычными bool/int64. Обёртки дают прежнюю семантику: null → false / -1.
// ВАЖНО: имена обёрток НЕ должны совпадать с std (str_*), иначе компилятор
// путает их с одноимёнными функциями std и обёртка вызывает сама себя.
load std.strings: starts_with, ends_with, index_of, index_of_from
load std.fs.paths: path_join

public fun str_starts(s: string, prefix: string) -> bool {
    set r: bool? = starts_with(s, prefix)
    return r ?? false
}

public fun str_ends(s: string, suffix: string) -> bool {
    set r: bool? = ends_with(s, suffix)
    return r ?? false
}

// индекс первого вхождения начиная с from_idx или -1
public fun str_index_from(s: string, sub: string, from_idx: int64) -> int64 {
    set r: int64? = index_of_from(s, sub, from_idx)
    return r ?? -1
}

// path_join из std вариадический; на двух аргументах он иногда не проходит проверку типов
public fun join2(a: string, b: string) -> string {
    return path_join(a, b)
}

// индекс первого вхождения или -1
public fun str_index(s: string, sub: string) -> int64 {
    set r: int64? = index_of(s, sub)
    return r ?? -1
}

public fun now_secs() -> int64 {
    set t = now_utc()
    return to_unix_secs(ref t)
}

public fun now_ms() -> int64 {
    set t = now_utc()
    return to_unix_millis(ref t)
}

public fun is_hex(s: string) -> bool {
    if s.len() == 0 {
        return false
    }
    for i in 0..s.len() {
        if !contains("0123456789abcdefABCDEF", slice(s, i, i + 1)) {
            return false
        }
    }
    return true
}

// [a-z0-9_-], 1..64 символа, не начинается с - или _
public fun valid_name(name: string) -> bool {
    if name.len() == 0 || name.len() > 64 {
        return false
    }
    if contains("-_", slice(name, 0, 1)) {
        return false
    }
    for i in 0..name.len() {
        if !contains("abcdefghijklmnopqrstuvwxyz0123456789_-", slice(name, i, i + 1)) {
            return false
        }
    }
    return true
}

// строго MAJOR.MINOR.PATCH, только цифры
public fun valid_version(v: string) -> bool {
    if v.len() == 0 || v.len() > 32 {
        return false
    }
    set parts = str_split(v, ".")
    if parts.len() != 3 {
        return false
    }
    for i in 0..3 {
        if !is_hex(parts[i]) {
            return false
        }
        set n = parse_int(parts[i])
        if n == null {
            return false
        }
    }
    return true
}

// 1 если a > b, -1 если a < b, 0 если равны. Вызывать только после valid_version.
// Число из строки цифр без parse_int (только 0-9; остальное считается за 0).
public fun digits_val(s: string) -> int64 {
    set v: int64 = 0
    for i in 0..s.len() {
        set d: int64 = 0
        for k in 0..10 {
            if eq(slice("0123456789", k, k + 1), slice(s, i, i + 1)) {
                rewrite d = k
            }
        }
        rewrite v = v * 10 + d
    }
    return v
}

public fun ver_cmp(a: string, b: string) -> int64 {
    set pa = str_split(a, ".")
    set pb = str_split(b, ".")
    set r: int64 = 0
    for i in 0..3 {
        if r == 0 {
            set x: int64 = digits_val(pa[i])
            set y: int64 = digits_val(pb[i])
            if x > y {
                rewrite r = 1
            } elif x < y {
                rewrite r = 0 - 1
            }
        }
    }
    return r
}

// "имя@1.2.3" — зависимость с точным закреплением версии
public fun valid_dep_spec(s: string) -> bool {
    set p = str_split(s, "@")
    return p.len() == 2 && valid_name(p[0]) && valid_version(p[1])
}

public fun dep_name(s: string) -> string {
    return str_split(s, "@")[0] + ""
}

public fun dep_version(s: string) -> string {
    return str_split(s, "@")[1] + ""
}

// Для подсказки «did you mean»: число правок между словами.
public fun edit_distance(a: string, b: string) -> int64 {
    set prev: int64[] = []
    for j in 0..(b.len() + 1) {
        prev.push(j)
    }
    for i in 1..(a.len() + 1) {
        set cur: int64[] = []
        cur.push(i)
        for j in 1..(b.len() + 1) {
            set cost: int64 = 1
            if eq(slice(a, i - 1, i), slice(b, j - 1, j)) {
                rewrite cost = 0
            }
            set best = prev[j] + 1
            if cur[j - 1] + 1 < best {
                rewrite best = cur[j - 1] + 1
            }
            if prev[j - 1] + cost < best {
                rewrite best = prev[j - 1] + cost
            }
            cur.push(best)
        }
        rewrite prev = cur
    }
    return prev[b.len()]
}

// ---------------------------------------------------------------------------
// Копирующие обёртки над std.strings.
// std split/lines/lower/pad_end/repeat/str_join возвращают указатель на ОДИН общий
// потоковый буфер: следующий вызов затирает предыдущий результат (eq(lower(a), lower(b))
// всегда истинно, два живых split портят друг друга). Здесь результат сразу копируется
// в регион вызывающего: массив через .cp(), строка через конкатенацию.
// ---------------------------------------------------------------------------
public fun str_split(s: string, delim: string) -> string[] {
    set r: string[] = split(s, delim)
    return r.cp()
}

public fun str_lines(s: string) -> string[] {
    set r: string[] = lines(s)
    return r.cp()
}

public fun str_lower(s: string) -> string {
    set r: string = lower(s)
    return r + ""
}

public fun str_pad_end(s: string, width: int64, pad: string = " ") -> string {
    set r: string = pad_end(s, width, pad)
    return r + ""
}

public fun str_repeat(s: string, n: int64) -> string {
    set r: string = repeat(s, n)
    return r + ""
}

public fun sjoin(items: string[], delim: string = "") -> string {
    set r: string = str_join(items, delim)
    return r + ""
}

// 1 → «package», иначе «packages» — единое множественное число для всех сводок.
public fun plural(n: int64, one: string, many: string) -> string {
    if n == 1 {
        return one
    }
    return many
}

// ── обход бага кодогена aarch64: cast(N -> "string") сегфолтится (§репро 9–13) ──
// Все числовые -> string в yuki идут через эти функции, пока баг не починен в компиляторе.

fun digit_str(d: int64) -> string {
    if d == 0 { return "0" }
    if d == 1 { return "1" }
    if d == 2 { return "2" }
    if d == 3 { return "3" }
    if d == 4 { return "4" }
    if d == 5 { return "5" }
    if d == 6 { return "6" }
    if d == 7 { return "7" }
    if d == 8 { return "8" }
    return "9"
}

// int64 -> string, цифры в правильном порядке, минус для отрицательных.
public fun int_str(n: int64) -> string {
    if n == 0 { return "0" }
    set neg = false
    set v: int64 = n
    if v < 0 {
        rewrite neg = true
        rewrite v = 0 - v
    }
    set out = ""
    loop {
        rewrite out = digit_str(v % 10) + out
        rewrite v = v / 10
        if v == 0 { break }
    }
    if neg {
        rewrite out = "-" + out
    }
    return out
}

// Байты в человекочитаемый вид (замена std.stdotool.format.format_bytes,
// которая внутри идёт через сломанный int->string).
public fun fmt_bytes(n: int64) -> string {
    if n < 1024 {
        return int_str(n) + " B"
    }
    set v: int64 = n
    set units: string[] = ["KiB", "MiB", "GiB", "TiB"]
    set ui: int64 = 0
    set rest: int64 = 0
    loop {
        rewrite rest = v % 1024
        rewrite v = v / 1024
        if v < 1024 || ui >= 3 {
            break
        }
        rewrite ui += 1
    }
    // одна десятая: rest*10/1024
    set tenth: int64 = (rest * 10) / 1024
    return int_str(v) + "." + int_str(tenth) + " " + units[ui]
}

// Скорость в человекочитаемый вид (замена format_speed).
public fun fmt_speed(bytes_per_sec: int64) -> string {
    return fmt_bytes(bytes_per_sec) + "/s"
}
