// resolver.ykn — разрешение дерева зависимостей.
// Версии в индексе закреплены точно ("имя@1.2.3"), поэтому результат
// детерминирован: SAT-решатель не нужен, только обход и проверка конфликтов.

load std.strings: eq
load .errors: YukiError, err
load .index: Release, resolve
load .util: dep_name, dep_version
load .view: InstallView

public struct Node {
    name: string
    version: string
    url: string
    checksum: string
    signer: string
    parent: int64
}

static MAX_DEPTH: int32 = 16
static MAX_NODES: int64 = 256

fun visit(name: string, want: string, parent: int64, depth: int32, ref ~out: Node[], ref ~view: InstallView) {
    if depth > MAX_DEPTH {
        panic(err("dependency chain is too deep", 215, name))
    }
    for i in 0..out.len() {
        if eq(out[i].name, name) {
            if want.len() > 0 && !eq(out[i].version, want) {
                panic(err("version conflict for " + name + ": " + out[i].version + " and " + want + " are both required", 217, name))
            }
            return
        }
    }
    if out.len() >= MAX_NODES {
        panic(err("too many packages in the dependency tree", 216, name))
    }

    set rel = resolve(name, want)
    set idx = out.len()
    out.push(Node {
        name: rel.name,
        version: rel.version,
        url: rel.url,
        checksum: rel.checksum,
        signer: rel.signer,
        parent: parent,
    })
    view.add_node(rel.name, rel.version, parent)
    view.draw(true)

    for k in 0..rel.deps.len() {
        visit(dep_name(rel.deps[k]), dep_version(rel.deps[k]), idx, depth + 1, ref ~out, ref ~view)
    }
}

// Корень первым, дальше в порядке обхода в глубину. Дерево растёт на панели по мере находок.
public fun resolve_tree(name: string, want: string, ref ~view: InstallView) -> Node[] {
    set out: Node[] = []
    visit(name, want, -1, 0, ref ~out, ref ~view)
    return out
}
