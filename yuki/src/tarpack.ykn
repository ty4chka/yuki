// tarpack.ykn — упаковщик tar(.zst/.gz) для `yuki pack` и сборки из исходников.
//
// Свой, потому что std.fs.archives.tar.tar_pack_dir не годится для пакетов:
// считает каталоги из dir_walk файлами (FsError на любом вложенном каталоге),
// кладёт в архив пути с префиксом исходного каталога, ставит всем 0644
// (теряется бит исполнения) и читает файл целиком в память.
// Здесь: относительные имена, записи каталогов, настоящий режим файла (только rwx),
// потоковое копирование, без setuid/setgid, mtime = 0 (воспроизводимый хеш).
// Симлинки в пакет не кладутся: std не умеет читать их цель, политика их и не любит.

load core.utils: cast
load core.panic: panic
load std.fs.files: File, file_open_read, file_open_write, file_metadata, file_remove
load std.fs.dirs: dir_exists, dir_walk
load std.compress: compress_file
load std.strings: slice
load .errors: YukiError, err
load .util: str_starts, str_ends

// Восьмеричное число ровно из digits цифр (старшие нули слева).
fun oct_str(val: int64, digits: int64) -> string {
    set res = ""
    set v: int64 = val
    for i in 0..digits {
        set d: int64 = v % 8
        rewrite res = slice("01234567", d, d + 1) + res
        rewrite v = v / 8
    }
    return res
}

// Один заголовок ustar (512 байт).
fun tar_header(ref out: File, name: string, size: int64, mode: int64, is_dir: bool) {
    set hdr: uint8[512]
    set nb: bytes = cast(name, "bytes")
    for i in 0..nb.len() {
        rewrite hdr[i] = nb[i]
    }
    set mb: bytes = cast(oct_str(mode, 7), "bytes")
    for i in 0..mb.len() {
        rewrite hdr[100 + i] = mb[i]
    }
    set zb: bytes = cast("0000000", "bytes")
    for i in 0..zb.len() {
        rewrite hdr[108 + i] = zb[i]
        rewrite hdr[116 + i] = zb[i]
    }
    set sb: bytes = cast(oct_str(size, 11), "bytes")
    for i in 0..sb.len() {
        rewrite hdr[124 + i] = sb[i]
    }
    set tb: bytes = cast("00000000000", "bytes")
    for i in 0..tb.len() {
        rewrite hdr[136 + i] = tb[i]
    }
    for i in 0..8 {
        rewrite hdr[148 + i] = 32u8
    }
    if is_dir {
        rewrite hdr[156] = 53u8
    } else {
        rewrite hdr[156] = 48u8
    }
    rewrite hdr[257] = 117u8
    rewrite hdr[258] = 115u8
    rewrite hdr[259] = 116u8
    rewrite hdr[260] = 97u8
    rewrite hdr[261] = 114u8
    rewrite hdr[262] = 0u8
    rewrite hdr[263] = 48u8
    rewrite hdr[264] = 48u8
    set sum: int64 = 0
    for i in 0..512 {
        rewrite sum = sum + cast(hdr[i], "int64")
    }
    set cb: bytes = cast(oct_str(sum, 6), "bytes")
    for i in 0..cb.len() {
        rewrite hdr[148 + i] = cb[i]
    }
    rewrite hdr[154] = 0u8
    rewrite hdr[155] = 32u8
    out.write(hdr.as_ptr(), 512)
}

// Упаковать каталог root в archive. Расширение решает сжатие: .tar.zst, .tar.gz/.tgz или без сжатия.
public fun tar_pack_tree(archive: string, root_in: string) {
    set root: string = root_in
    while root.len() > 1 && str_ends(root, "/") {
        rewrite root = slice(root, 0, root.len() - 1)
    }
    if !dir_exists(root) {
        panic(err("directory not found: " + root, 501, root))
    }
    set zst: bool = str_ends(archive, ".tar.zst")
    set gz: bool = str_ends(archive, ".tar.gz") || str_ends(archive, ".tgz")
    set raw: string = archive
    if zst || gz {
        rewrite raw = archive + ".tmp.tar"
    }
    set out = file_open_write(raw)
    set all: string[] = dir_walk(root).cp()
    set prefix: string = root + "/"
    set buf: uint8[16384]
    set zeros: uint8[1024]
    for i in 0..all.len() {
        set p: string = all[i]
        if !str_starts(p, prefix) {
            continue
        }
        set rel: string = slice(p, prefix.len(), p.len())
        if rel.len() == 0 {
            continue
        }
        if rel.len() > 99 {
            out.close()
            panic(err("path is too long for the archive (max 99 bytes): " + rel, 723, rel))
        }
        set md = file_metadata(p)
        if md.is_symlink {
            out.close()
            panic(err("symlinks are not allowed in a package: " + rel, 722, rel))
        }
        if md.is_dir {
            tar_header(ref out, rel + "/", 0, 493, true)
        } elif md.is_file {
            set perm: int64 = cast(md.mode, "int64") % 512
            tar_header(ref out, rel, md.size, perm, false)
            set src = file_open_read(p)
            set left: int64 = md.size
            while left > 0 {
                set n: int64 = src.read(buf.as_ptr(), 16384)
                if n <= 0 {
                    break
                }
                if n > left {
                    rewrite n = left
                }
                out.write(buf.as_ptr(), n)
                rewrite left = left - n
            }
            src.close()
            if left != 0 {
                out.close()
                panic(err("file changed while packing: " + rel, 724, rel))
            }
            set pad: int64 = (512 - (md.size % 512)) % 512
            if pad > 0 {
                out.write(zeros.as_ptr(), pad)
            }
        }
    }
    out.write(zeros.as_ptr(), 1024)
    out.close()
    if zst {
        compress_file(raw, archive, "zstd")
        file_remove(raw)
    } elif gz {
        compress_file(raw, archive, "gz")
        file_remove(raw)
    }
}
