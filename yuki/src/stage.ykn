// stage.ykn — рабочий каталог транзакции и запуск непривилегированного ребёнка.
//
//   <state>/stage/<id>/           root, 0711
//     dl/                         nobody, 0700: сюда пишет ребёнок (сеть, сборка)
//     art/  root/  roots  approved   root: копии, распаковка, список корней и одобренных сборок
//
// Ребёнок — fork(): он наследует память, поэтому параметры не нужно никуда передавать,
// а его результат читается только как данные: root проверяет всё заново.
// Пока ребёнок работает, родитель не блокируется: он опрашивает файлы прогресса и
// рисует панель (анимация не замирает).

load core.utils: cast
load core.panic: panic
load core.process: exit
load std.os.unix: fork, waitpid, chmod, chown
load std.threads: sleep
load std.crypto: random_bytes
load std.hash: bytes_to_hex
load std.fs.files: file_exists, file_read_text, file_write_text
load std.fs.dirs: dir_create_all, dir_remove_all
load std.fs.defaults: dir_temp
load std.outf: strip_ansi
load std.strings: slice, eq, trim, parse_int
load .errors: YukiError, err
load .config: state_dir
load .priv: drop_privileges, kill_child_group, nobody_id, is_root
load .sysplan: child_plan, child_keys, child_catalog
load .sysbuild: child_fetch
load .pool: pool_paint, pool_ok
load .verify: VerifyError
load .view: InstallView
load .util: now_ms, join2, sjoin, str_split

fun stage_token() -> string {
    set rnd: bytes = random_bytes(8)
    return cast(now_ms(), "string") + "-" + bytes_to_hex(ref rnd)
}

public fun stage_create() -> string {
    set m700: uint32 = 448
    if !is_root() {
        // запросы без root (search, show, outdated): рабочий каталог в temp с криптостойким именем и правами 0700
        set top = join2(dir_temp(), "yuki-" + stage_token())
        dir_create_all(top)
        chmod(top, m700)
        set own = join2(top, "stage")
        dir_create_all(join2(own, "dl"))
        dir_create_all(join2(own, "art"))
        dir_create_all(join2(own, "root"))
        chmod(own, m700)
        return own
    }
    set base = join2(state_dir(), "stage")
    dir_create_all(base)
    set m711: uint32 = 457
    set nb: uint32 = 65534
    chmod(base, m711)
    set stage = join2(base, stage_token())
    dir_create_all(stage)
    chmod(stage, m711)
    set dl = join2(stage, "dl")
    dir_create_all(dl)
    chmod(dl, m700)
    chown(dl, nb, nb)
    dir_create_all(join2(stage, "art"))
    dir_create_all(join2(stage, "root"))
    return stage
}

public fun stage_remove(stage: string) {
    dir_remove_all(stage)
}

// Корни установки: пишет родитель (root), читает ребёнок.
public fun write_roots(stage: string, ref roots: string[]) {
    file_write_text(join2(stage, "roots"), sjoin(roots.cp(), "\n") + "\n")
}

// Текст от ребёнка недоверенный: без управляющих последовательностей, одной строкой, обрезанный.
fun clean_msg(s: string) -> string {
    set one = sjoin(str_split(strip_ansi(s), "\n"), " ")
    if one.len() > 300 {
        return slice(one, 0, 300) + "…"
    }
    return one
}

// mode: "plan" | "fetch" | "keys" | "catalog". Возвращается только после успешного завершения ребёнка.
// jobmap[j] — узел панели для j-й загрузки (только для mode == "fetch"; иначе пустой массив).
public fun run_child(stage: string, mode: string, ref ~view: InstallView, ref jobmap: int64[]) {
    set dl = join2(stage, "dl")
    set pid = fork()
    if pid < 0 {
        panic(err("fork failed", 703, ""))
    }
    if pid == 0 {
        sus {
            drop_privileges(nobody_id(), nobody_id())
            if eq(mode, "plan") {
                child_plan(dl)
            } elif eq(mode, "fetch") {
                child_fetch(dl, join2(stage, "approved"))
            } elif eq(mode, "catalog") {
                child_catalog(dl)
            } else {
                child_keys(dl)
            }
            file_write_text(join2(dl, "DONE-" + mode), "ok")
        } catch e: YukiError {
            file_write_text(join2(dl, "ERROR"), cast(e.code, "string") + "\n" + e.message)
        } catch e: VerifyError {
            file_write_text(join2(dl, "ERROR"), cast(300 + e.code, "string") + "\n" + e.message)
        } catch {
            file_write_text(join2(dl, "ERROR"), "751\nunexpected failure: " + errkind)
        }
        exit(0)
    }

    // родитель не блокируется: рисует панель по файлам прогресса ребёнка, сбрасывая регион на каждом шаге
    set t0 = now_ms()
    set pool_dir = join2(dl, "pool")
    // Без region: строки скорости и активности сохраняются в полях панели и живут дольше кадра.
    while waitpid(pid, 1) == 0 {
        if eq(mode, "fetch") && jobmap.len() > 0 {
            pool_paint(pool_dir, jobmap.len(), ref jobmap, t0, ref ~view)
            for j in 0..jobmap.len() {
                if jobmap[j] >= 0 && pool_ok(pool_dir, j) {
                    view.set_state(jobmap[j], 2)
                }
            }
            set act = join2(dl, "activity")
            if file_exists(act) {
                sus {
                    view.set_activity(clean_msg(file_read_text(act)))
                } catch {
                    set _ign = 0
                }
            }
        }
        view.draw(false)
        sleep(60u64)
    }
    kill_child_group(cast(pid, "int64"))
    if !file_exists(join2(dl, "DONE-" + mode)) {
        set why = "the unprivileged step did not finish"
        set code: int32 = 751
        if file_exists(join2(dl, "ERROR")) {
            set raw = file_read_text(join2(dl, "ERROR"))
            set l = str_split(raw, "\n")
            set n: int64 = parse_int(trim(l[0])) ?? 0
            if l.len() >= 2 && n >= 100 && n <= 999 {
                rewrite code = cast(n, "int32")
                rewrite why = clean_msg(slice(raw, l[0].len() + 1, raw.len()))
            } else {
                rewrite why = clean_msg(raw)
            }
        }
        panic(err(why, code, mode))
    }
}