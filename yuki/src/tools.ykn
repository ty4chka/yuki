fun yn(b: bool) -> string {
    if b {
        return "yes"
    }
    return "no"
}

fun tools_need_root() {
    if !is_root() {
        panic(err("this changes the system: run it with sudo", 750, ""))
    }
}

fun tools_in_list(ref l: string[], x: string) -> bool {
    for i in 0..l.len() {
        if eq(l[i], x) {
            return true
        }
    }
    return false
}

// ── запросы к индексу (без root, через непривилегированный ребёнок) ──────

fun plan_for(name: string, want: string) -> PNode[] {
    set spec = name
    if want.len() > 0 {
        rewrite spec = name + "@" + want
    }
    set roots: string[] = [spec]
    set stage = stage_create()
    write_roots(stage, ref roots)
    set quiet = init InstallView("", false)
    set nomap: int64[] = []
    set nodes: PNode[] = []
    sus {
        run_child(stage, "plan", ref ~quiet, ref nomap)
        rewrite nodes = plan_nodes(join2(stage, "dl"), ref roots, false, false)
    } catch e: YukiError {
        stage_remove(stage)
        panic(e)
    } catch {
        stage_remove(stage)
        panic(err("could not query the index: " + errkind, 755, name))
    }
    stage_remove(stage)
    return nodes
}

public fun cmd_show(spec: string) {
    set at = str_index(spec, "@")
    set name = spec
    set want = ""
    if at > 0 {
        rewrite name = slice(spec, 0, at)
        rewrite want = slice(spec, at + 1, spec.len())
    }
    set nodes = plan_for(name, want)
    println("")
    println("  " + c_bold(nodes[0].rel.name) + " " + c_good(nodes[0].rel.version) + "   " + c_dim(nodes[0].rel.kind))
    if nodes[0].rel.summary.len() > 0 {
        kv("summary", nodes[0].rel.summary)
    }
    if nodes[0].rel.homepage.len() > 0 {
        kv("homepage", nodes[0].rel.homepage)
    }
    if nodes[0].rel.license.len() > 0 {
        kv("license", nodes[0].rel.license)
    }
    kv("signed by", nodes[0].rel.signer)
    set act = nodes[0].action
    if eq(act, "bin") || eq(act, "installed") {
        kv("install", "prebuilt binary for " + host_target())
    } elif eq(act, "src") {
        kv("install", "no binary for " + host_target() + ", builds from source: " + sjoin(nodes[0].rel.build, " "))
    } else {
        kv("install", "not available for " + host_target())
    }
    if nodes[0].rel.deps.len() > 0 {
        kv("depends", sjoin(nodes[0].rel.deps, ", "))
    } else {
        kv("depends", "none")
    }
    if db_has(name) {
        kv("status", "installed " + db_read(name).version)
    } else {
        kv("status", "not installed")
    }
    if nodes.len() > 1 {
        println("")
        println("  " + c_accent("::") + " would install " + cast(nodes.len(), "string") + " packages:")
        for i in 0..nodes.len() {
            println("      " + nodes[i].rel.name + " " + c_dim(nodes[i].rel.version + "  " + nodes[i].action))
        }
    }
    println("")
}

public fun cmd_outdated() {
    set names = db_names()
    set found: int64 = 0
    for i in 0..names.len() {
        set cur = db_read(names[i]).version
        set nodes = plan_for(names[i], "")
        if valid_version(cur) && valid_version(nodes[0].rel.version) {
            if ver_cmp(nodes[0].rel.version, cur) > 0 {
                println("  " + c_accent(str_pad_end(names[i], 20)) + c_dim(cur + " " + sym("arrow") + " ") + c_good(nodes[0].rel.version))
                rewrite found += 1
            }
        }
    }
    if found == 0 {
        ok("everything is up to date")
    }
}

fun verified_catalog() -> string {
    set stage = stage_create()
    set text = ""
    sus {
        set quiet = init InstallView("", false)
        set nomap: int64[] = []
        run_child(stage, "catalog", ref ~quiet, ref nomap)
        set dl = join2(stage, "dl")
        rewrite text = file_read_text(join2(dl, "catalog.json"))
        set sig = trim(file_read_text(join2(dl, "catalog.json.sig")))
        set keys = trusted_keys()
        if keys.len() == 0 {
            panic(err("no trusted keys yet", 202, "catalog.json"))
        }
        if verify_text_with_any(ref keys, text, sig) < 0 {
            panic(VerifyError { message: "catalog is not signed by a trusted key", code: 3, path: "catalog.json" })
        }
        set doc = json_parse(text)
        if doc.get("expires").as_int() < now_secs() {
            panic(err("catalog has expired", 204, "catalog.json"))
        }
        if doc.get("seq").as_int() < seen_get("__catalog__") {
            panic(err("catalog is older than one already seen (rollback attack?)", 205, "catalog.json"))
        }
        if is_root() {
            seen_set("__catalog__", doc.get("seq").as_int())
        }
    } catch e: YukiError {
        stage_remove(stage)
        panic(e)
    } catch e: VerifyError {
        stage_remove(stage)
        panic(e)
    } catch {
        stage_remove(stage)
        panic(err("could not load the catalog: " + errkind, 755, ""))
    }
    stage_remove(stage)
    return text
}

public fun cmd_search(term: string) {
    set doc = json_parse(verified_catalog())
    set pk = doc.get("packages")
    set q = str_lower(term)
    set shown: int64 = 0
    for i in 0..pk.len() {
        set nm = pk.at(i).get("name").as_string_or("")
        set sm = pk.at(i).get("summary").as_string_or("")
        if contains(str_lower(nm), q) || contains(str_lower(sm), q) {
            set mark = ""
            if db_has(nm) {
                rewrite mark = " " + c_good("[installed]")
            }
            println("  " + c_accent(nm) + " " + c_good(pk.at(i).get("version").as_string_or("")) + " " + c_dim(pk.at(i).get("kind").as_string_or("")) + mark)
            if sm.len() > 0 {
                println("      " + c_dim(sm))
            }
            rewrite shown += 1
        }
    }
    if shown == 0 {
        warn("nothing matches \"" + term + "\"")
    }
}

// ── что установлено и как связано ───────────────────────────────────────

public fun cmd_list(filter: string) {
    set names = db_names()
    set shown: int64 = 0
    for i in 0..names.len() {
        set r = db_read(names[i])
        set pass = true
        if eq(filter, "explicit") {
            rewrite pass = !eq(r.reason, "dep")
        } elif eq(filter, "deps") {
            rewrite pass = eq(r.reason, "dep")
        } elif filter.len() > 0 {
            rewrite pass = contains(str_lower(r.name), str_lower(filter)) || contains(str_lower(r.summary), str_lower(filter))
        }
        if pass {
            set why = "explicit"
            if eq(r.reason, "dep") {
                rewrite why = "dependency"
            }
            println("  " + c_accent(str_pad_end(r.name, 20)) + c_good(str_pad_end(r.version, 10)) + c_dim(str_pad_end(why, 12) + r.origin))
            if r.summary.len() > 0 {
                println("      " + c_dim(r.summary))
            }
            rewrite shown += 1
        }
    }
    if shown == 0 {
        info("no packages")
    }
}

public fun cmd_orphans() {
    set o = orphans()
    if o.len() == 0 {
        ok("no orphaned dependencies")
        return
    }
    for i in 0..o.len() {
        println("  " + c_warn("-") + " " + c_accent(o[i]) + " " + c_dim(db_read(o[i]).version))
    }
    info("`sudo yuki autoremove` removes them")
}

fun dep_names(name: string) -> string[] {
    set out: string[] = []
    set ds = str_split(db_read(name).deps, ",")
    for i in 0..ds.len() {
        if ds[i].len() > 0 {
            out.push(ds[i])
        }
    }
    return out
}

fun node_label(name: string) -> string {
    if db_has(name) {
        return c_accent(name) + " " + c_dim(db_read(name).version)
    }
    return c_bad(name) + c_dim(" (not installed)")
}

// up == false: от пакета вниз, к его зависимостям; up == true: вверх, к тем, кому он нужен.
fun print_branch(name: string, prefix: string, depth: int64, up: bool, ref ~seen: string[]) {
    if depth > 8 {
        return
    }
    set kids: string[] = []
    if up {
        rewrite kids = dependents_of(name)
    } else {
        rewrite kids = dep_names(name)
    }
    for i in 0..kids.len() {
        set last = i == kids.len() - 1
        set glyph = sym("branch")
        set pad = sym("pipe") + "  "
        if last {
            rewrite glyph = sym("last")
            rewrite pad = "   "
        }
        set again = tools_in_list(ref seen, kids[i])
        set tail = ""
        if again {
            rewrite tail = c_dim("  (shown above)")
        }
        println("  " + c_dim(prefix + glyph) + " " + node_label(kids[i]) + tail)
        if !again && db_has(kids[i]) {
            seen.push(kids[i])
            print_branch(kids[i], prefix + pad, depth + 1, up, ref ~seen)
        }
    }
}

fun need_installed(name: string) {
    if !db_has(name) {
        panic(err("package is not installed: " + name, 710, name))
    }
}

public fun cmd_tree(name: string) {
    need_installed(name)
    println("  " + c_bold(name) + " " + c_good(db_read(name).version))
    set seen: string[] = [name]
    print_branch(name, "", 0, false, ref ~seen)
    if dep_names(name).len() == 0 {
        println("  " + c_dim(sym("last") + " no dependencies"))
    }
}

public fun cmd_rdeps(name: string) {
    need_installed(name)
    println("  " + c_bold(name) + " " + c_good(db_read(name).version) + c_dim("   required by"))
    set seen: string[] = [name]
    print_branch(name, "", 0, true, ref ~seen)
    if dependents_of(name).len() == 0 {
        println("  " + c_dim(sym("last") + " nothing depends on it"))
    }
}

public fun cmd_related(name: string) {
    need_installed(name)
    set r = db_read(name)
    println("")
    println("  " + c_bold(r.name) + " " + c_good(r.version) + "   " + c_dim(r.origin))
    if r.summary.len() > 0 {
        println("  " + c_dim(r.summary))
    }
    println("")
    println("  " + c_accent("::") + " depends on")
    set a: string[] = [name]
    print_branch(name, "", 0, false, ref ~a)
    if dep_names(name).len() == 0 {
        println("  " + c_dim(sym("last") + " nothing"))
    }
    println("")
    println("  " + c_accent("::") + " required by")
    set b: string[] = [name]
    print_branch(name, "", 0, true, ref ~b)
    if dependents_of(name).len() == 0 {
        println("  " + c_dim(sym("last") + " nothing"))
    }
    println("")
}

public fun cmd_why(name: string) {
    need_installed(name)
    set r = db_read(name)
    set users = dependents_of(name)
    if users.len() > 0 {
        ok(name + " is needed by " + c_accent(sjoin(users.cp(), ", ")))
    }
    if !eq(r.reason, "dep") {
        ok(name + " was installed explicitly")
    } elif users.len() == 0 {
        warn(name + " is an orphan: it came as a dependency and nothing needs it")
        info("`sudo yuki autoremove` removes orphans")
    }
}

public fun cmd_graph(mode: string) {
    set names = db_names()
    if eq(mode, "dot") {
        println("digraph yuki {")
        println("  rankdir=LR;")
        for i in 0..names.len() {
            set ds = dep_names(names[i])
            if ds.len() == 0 {
                println("  \"" + names[i] + "\";")
            }
            for k in 0..ds.len() {
                println("  \"" + names[i] + "\" -> \"" + ds[k] + "\";")
            }
        }
        println("}")
        return
    }
    set seen: string[] = []
    for i in 0..names.len() {
        if dependents_of(names[i]).len() == 0 {
            println("  " + c_bold(names[i]) + " " + c_good(db_read(names[i]).version))
            seen.push(names[i])
            print_branch(names[i], "", 0, false, ref ~seen)
        }
    }
}

// ── диагностика окружения ───────────────────────────────────────────────

fun chk(good: bool, yes_msg: string, no_msg: string, fix: string, ref ~problems: int64) {
    if good {
        ok(yes_msg)
    } else {
        warn(no_msg)
        println("      " + c_dim(sym("arrow")) + " " + fix)
        rewrite problems += 1
    }
}

public fun cmd_doctor() {
    set problems: int64 = 0
    println("")
    info("platform " + c_accent(host_target()) + c_dim("  running as root: " + yn(is_root())))

    set idx = ""
    sus {
        rewrite idx = index_url()
    } catch {
        rewrite idx = ""
    }
    chk(idx.len() > 0, "index " + c_dim(idx), "no index is configured", "export YUKI_INDEX=https://raw.githubusercontent.com/<org>/<repo>/main  (or write it to " + config_dir() + "/index_url)", ref ~problems)

    set keys = trusted_keys()
    chk(keys.len() > 0, cast(keys.len(), "string") + " trusted key(s)", "no trusted keys", "yuki keys trust <name> <pubkey>   (sudo for system installs)", ref ~problems)
    if keys.len() > 0 {
        chk(threshold() >= 2 || keys.len() < 2, "key rotation threshold " + cast(threshold(), "string"), "single-signer rotation", "echo 2 | sudo tee " + config_dir() + "/threshold   (2 of 3 recommended)", ref ~problems)
    }

    chk(have_bwrap(), "bubblewrap found: source builds are sandboxed", "bubblewrap is missing", "install it (apt/pacman/dnf: bubblewrap); without it builds from source are refused", ref ~problems)
    set has_timeout = false
    sus {
        rewrite has_timeout = run("timeout", ["--version"]).success()
    } catch {
        rewrite has_timeout = false
    }
    chk(has_timeout, "timeout (coreutils) found", "timeout is missing", "install coreutils; source builds use it to cap build time", ref ~problems)

    chk(supports_truecolor(), "truecolor terminal", "no truecolor: colors fall back to 256/16", "set COLORTERM=truecolor, or use palette = \"ansi\" in theme.toml", ref ~problems)
    chk(eq(sym("ok"), "✔"), "unicode symbols", "ASCII mode is active", "use a UTF-8 locale (LANG=en_US.UTF-8) or set unicode = true in theme.toml", ref ~problems)
    chk(now_secs() > 1700000000, "system clock looks sane", "system clock is far in the past", "fix the date: signed index entries have expiry dates", ref ~problems)

    set cfg = config_dir()
    if dir_exists(cfg) {
        set mask: uint32 = 18
        set zero: uint32 = 0
        set bits: uint32 = file_metadata(cfg).mode & mask
        chk(bits == zero, cfg + " is not writable by others", cfg + " is writable by group/others", "sudo chmod go-w " + cfg + "   (anyone could add trusted keys)", ref ~problems)
    }
    chk(!dir_exists(join2(state_dir(), "lock")), "no stale lock", "a lock directory exists", "if no yuki is running, remove it: sudo rm -r " + join2(state_dir(), "lock"), ref ~problems)
    chk(db_names().len() >= 0, cast(db_names().len(), "string") + " package(s) in the database", "database unreadable", "check permissions of " + state_dir(), ref ~problems)

    if idx.len() > 0 {
        set reach = true
        sus {
            http_text(idx + "/catalog.json", 4194304)
        } catch {
            rewrite reach = false
        }
        chk(reach, "index is reachable", "could not download the catalog from the index", "check the URL, your network or proxy; the index needs a signed catalog.json (`yuki index catalog`)", ref ~problems)
    }
    println("")
    if problems == 0 {
        ok("all good")
    } else {
        warn(cast(problems, "string") + " thing(s) to look at")
    }
}

public fun cmd_config() {
    println("")
    kv("mode", "system (sudo installs)")
    if !system_mode() {
        kv("mode", "user")
    }
    kv("config", config_dir())
    kv("state", state_dir())
    kv("cache", cache_dir())
    set idx = ""
    sus {
        rewrite idx = index_url()
    } catch {
        rewrite idx = "(not set)"
    }
    kv("index", idx)
    kv("platform", host_target())
    kv("trusted keys", cast(trusted_keys().len(), "string") + ", threshold " + cast(threshold(), "string"))
    kv("sandbox", build_policy())
    kv("theme", theme_path() + ", palette " + theme_palette())
    kv("animation", yn(animation_on()))
    kv("held", cast(held_names().len(), "string") + " package(s)")
    println("")
}

public fun cmd_clean(everything: bool) {
    set dir = cache_dir()
    set freed: int64 = 0
    set count: int64 = 0
    if dir_exists(dir) {
        set files = dir_walk(dir)
        for i in 0..files.len() {
            set md = file_metadata(files[i])
            if md.is_file && (everything || contains(files[i], ".part")) {
                rewrite freed += md.size
                rewrite count += 1
                file_remove(files[i])
            }
        }
    }
    if is_root() {
        set stage = join2(state_dir(), "stage")
        if dir_exists(stage) {
            dir_remove_all(stage)
        }
    }
    ok("removed " + cast(count, "string") + " file(s), freed " + format_bytes(freed))
}

// ── hold, export, import ────────────────────────────────────────────────

public fun cmd_hold(name: string) {
    if name.len() == 0 {
        set h = held_names()
        if h.len() == 0 {
            info("no held packages")
        }
        for i in 0..h.len() {
            println("  " + c_warn(sym("pending")) + " " + h[i])
        }
        return
    }
    tools_need_root()
    need_installed(name)
    if is_held(name) {
        info(name + " is already held")
        return
    }
    dir_create_all(config_dir())
    set h = held_names()
    h.push(name)
    file_write_text(join2(config_dir(), "hold"), sjoin(h, "\n") + "\n")
    ok(name + " is held at " + db_read(name).version + ": upgrade will skip it")
}

public fun cmd_unhold(name: string) {
    tools_need_root()
    set h = held_names()
    set out: string[] = []
    set found = false
    for i in 0..h.len() {
        if eq(h[i], name) {
            rewrite found = true
        } else {
            out.push(h[i])
        }
    }
    file_write_text(join2(config_dir(), "hold"), sjoin(out, "\n") + "\n")
    if found {
        ok(name + " is no longer held")
    } else {
        warn(name + " was not held")
    }
}

public fun cmd_export() {
    set names = db_names()
    for i in 0..names.len() {
        if is_explicit(names[i]) {
            println(names[i] + "@" + db_read(names[i]).version)
        }
    }
}

public fun cmd_import(file: string) {
    tools_need_root()
    if !file_exists(file) {
        panic(err("file not found: " + file, 501, file))
    }
    set ls = str_lines(file_read_text(file))
    for i in 0..ls.len() {
        set l = trim(ls[i])
        if l.len() > 0 && !str_starts(l, "#") {
            cmd_sys_install(l)
        }
    }
}

// ── справка ─────────────────────────────────────────────────────────────

public fun cmd_explain(code: string) {
    set raw = str_lower(trim(code))
    if str_starts(raw, "y") {
        rewrite raw = slice(raw, 1, raw.len())
    }
    set n: int64 = parse_int(raw) ?? 0
    set l = explain_lines(n)
    if l.len() == 0 {
        panic(err("no explanation for \"" + code + "\"", 201, code))
    }
    println("")
    println("  " + c_bad("Y" + pad_start_zero(n)) + "  " + c_bold(l[0]))
    println("")
    println("  " + c_dim("why") + "   " + l[1])
    println("  " + c_good("fix") + "   " + l[2])
    println("")
}

fun pad_start_zero(n: int64) -> string {
    set s = cast(n, "string")
    for k in 0..(4 - s.len()) {
        rewrite s = "0" + s
    }
    return s
}

public fun cmd_help(cmd: string) {
    set l = help_lines(cmd)
    if l.len() == 0 {
        set s = suggest(cmd)
        if s.len() > 0 {
            panic(err("no such command: " + cmd + ". Did you mean `" + s + "`?", 201, cmd))
        }
        panic(err("no such command: " + cmd, 201, cmd))
    }
    println("")
    println("  " + c_bold(l[0]))
    println("  " + l[1])
    if l.len() > 2 {
        println("")
        println("  " + c_dim("examples"))
        for i in 2..l.len() {
            println("    " + c_accent(l[i]))
        }
    }
    println("")
}

public fun cmd_completions(shell: string) {
    set s = completion_script(shell)
    if s.len() == 0 {
        panic(err("shell must be bash, zsh or fish", 201, shell))
    }
    print(s)
}

// ── сборка пакета ───────────────────────────────────────────────────────

fun tools_strip_root(p: string, root: string) -> string {
    if str_starts(p, root + "/") {
        return slice(p, root.len() + 1, p.len())
    }
    return ""
}

// yuki pack <name> <dir> <out>: собрать архив пакета, проверить политику, показать хеш и кусок записи индекса.
public fun cmd_pack(name: string, dir: string, out: string) {
    if !valid_name(name) {
        panic(err("invalid package name: " + name, 201, name))
    }
    if !dir_exists(dir) {
        panic(err("directory not found: " + dir, 501, dir))
    }
    set all = dir_walk(dir)
    set problems: int64 = 0
    set count: int64 = 0
    for i in 0..all.len() {
        set rel = tools_strip_root(all[i], dir)
        if rel.len() == 0 {
            continue
        }
        set md = file_metadata(all[i])
        if md.is_symlink {
            rewrite count += 1
            continue
        }
        set why = policy_check(name, rel)
        if why.len() > 0 {
            bad(rel + "  " + c_dim(why))
            rewrite problems += 1
        }
        if md.is_file {
            rewrite count += 1
        }
    }
    if problems > 0 {
        panic(err(cast(problems, "string") + " path(s) break the install policy", 721, dir))
    }
    tar_pack_dir(out, dir, "auto")
    set rep = audit_tar(out, MAX_ENTRIES, MAX_TOTAL, MAX_FILE, true)
    set checksum = "blake3:" + blake3_file(out)
    ok("packed " + cast(count, "string") + " files " + c_dim("(" + format_bytes(file_size(out)) + ")"))
    ok("archive audit passed")
    println("")
    println("  " + c_dim("paste into your release json:"))
    println("    \"bin\": [{ \"target\": \"" + host_target() + "\", \"url\": \"https://github.com/<you>/<repo>/releases/download/v<ver>/" + out + "\", \"checksum\": \"" + checksum + "\" }]")
    println("")
}
